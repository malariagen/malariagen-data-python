digraph inheritance {
    bgcolor="transparent";
    rankdir=RL;
    fontsize=16;
    node [fontsize=16, shape=box, fontname="Helvetica,Arial,sans-serif"];
    edge [color="#16a34a"];

    "Adir1" [style="filled,rounded", fillcolor="#dcfce7", color="#15803d", fontcolor="#14532d", tooltip="Anopheles dirus complex."];
    "AnophelesDataResource" -> "Adir1";

